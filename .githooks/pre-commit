#!/bin/sh
# Ruff на индексированных .py-файлах backend/app и backend/tests — та же
# область, что в Backend CI (конфиг — backend/pyproject.toml).
# Подключается командой make hooks.
cd "$(git rev-parse --show-toplevel)" || exit 1

if git diff --cached --quiet --diff-filter=ACMR -- ':(glob)backend/app/**/*.py' ':(glob)backend/tests/**/*.py'; then
  exit 0
fi

if command -v ruff >/dev/null 2>&1; then
  set -- ruff
elif python3 -m ruff --version >/dev/null 2>&1; then
  set -- python3 -m ruff
else
  echo "pre-commit: ruff не найден, проверка пропущена (pip install -r backend/requirements.txt)" >&2
  exit 0
fi

status=0
git diff --cached -z --name-only --diff-filter=ACMR -- ':(glob)backend/app/**/*.py' ':(glob)backend/tests/**/*.py' \
  | xargs -0 "$@" check -- || status=1
git diff --cached -z --name-only --diff-filter=ACMR -- ':(glob)backend/app/**/*.py' ':(glob)backend/tests/**/*.py' \
  | xargs -0 "$@" format --check -- || status=1

if [ "$status" -ne 0 ]; then
  echo "pre-commit: ruff нашёл нарушения; исправьте (cd backend && ruff check --fix app tests && ruff format app tests) и добавьте файлы снова" >&2
fi
exit "$status"
