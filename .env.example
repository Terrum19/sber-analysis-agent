# Файл не обязателен: без .env всё работает на значениях по умолчанию.
# LLM — локально, замкнутый контур (Ollama или vLLM, OpenAI-совместимый протокол).
# Адрес для make dev; в docker compose его задаёт COMPOSE_LLM_BASE_URL (ниже).
LLM_BASE_URL=http://localhost:11434/v1
# Адрес LLM для backend в docker compose. По умолчанию — Ollama на хосте
# (http://host.docker.internal:11434/v1); make up-ollama и make up-gpu ставят
# http://ollama:11434/v1 (Ollama в контейнере). Свой сервер (vLLM, GPU-машина):
# COMPOSE_LLM_BASE_URL=http://10.0.0.5:8001/v1
# Модель для make up, make up-ollama и make dev; make up-gpu берёт LLM_MODEL_GPU.
# Ollama скачивает её сама при первом запуске (LLM_PREPARE_MODEL ниже).
# Окончательный выбор моделей — #58 (docs/reports/llm_choice.md).
LLM_MODEL=qwen2.5-coder:7b
LLM_MODEL_GPU=qwen2.5-coder:14b
# Контекст модели в токенах (#102): и для Ollama в контейнере, и для варианта
# модели, который backend создаёт на Ollama вне контейнера (LLM_NUM_CTX в compose).
OLLAMA_CONTEXT_LENGTH=16384
# Модель эмбеддингов: агент по смыслу вопроса переходит к другим данным посреди
# сессии («а погода?» -> таблица «Температура по дням»). Ollama скачивает её сама
# (~1,2 ГБ); пусто — переход только по словам вопроса.
EMBED_MODEL=bge-m3
# Сервер эмбеддингов, если не тот, что у LLM (OpenRouter: EMBED_MODEL=baai/bge-m3).
EMBED_BASE_URL=
# Порт Ollama в контейнере на хосте (11434 занимает Ollama вне контейнера)
OLLAMA_PORT=11435
# Ключ облачного провайдера (OpenRouter и т.п.); для Ollama/vLLM можно не задавать.
LLM_API_KEY=
LLM_TIMEOUT_S=600
# Повторы при 429/5xx/таймауте; каждый повтор таймаута — ещё до LLM_TIMEOUT_S.
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.0
# json_schema — ответ по JSON-схеме (по умолчанию); tools — instructor function calling.
LLM_STRUCTURED_MODE=json_schema
# Исправления качества плана и инсайта; отбор тулов под вопрос (выключен).
AGENT_QUALITY_FIXES=true
AGENT_TOOL_TOPK=false
# Контекст модели в токенах. Задаётся на сервере: Ollama — OLLAMA_CONTEXT_LENGTH
# (по умолчанию 4096, длинный промпт молча обрезается; options.num_ctx в запросе к /v1
# не действует), vLLM — --max-model-len (infra/vllm/serve.sh). Здесь — то же число:
# от него считается бюджет промпта, а клиент предупреждает, если у сервера меньше.
LLM_NUM_CTX=16384
# Ollama: скачать LLM_MODEL, если её нет, и работать с её вариантом с контекстом
# LLM_NUM_CTX (<модель>-ctx<число>) — тогда OLLAMA_CONTEXT_LENGTH на сервере не нужен.
LLM_PREPARE_MODEL=true
# Символов на токен для оценки длины промпта; уточнить — scripts/check_llm_client.py
LLM_CHARS_PER_TOKEN=2.5

# Уровень логов бэкенда: DEBUG, INFO (по умолчанию), WARNING, ERROR. На DEBUG в лог
# идут промпты и ответы модели. Лог — в консоль и в STORAGE_DIR/logs/backend.log
# (ротация 5 МБ × 3).
LOG_LEVEL=INFO

# Хранилище
STORAGE_DIR=backend/storage
DUCKDB_PATH=backend/storage/duckdb/main.duckdb
SQLITE_PATH=backend/storage/sessions/sessions.sqlite
# Лимит размера одного загружаемого CSV (МБ); файлы лежат в STORAGE_DIR/uploads/<datasource_id>/
CSV_MAX_UPLOAD_MB=1024
# Срок жизни temp_result_vN (с); плитки дашбордов и графики сессий за 24 ч не удаляются
RESULT_TTL_S=21600

# Лимиты песочницы / агента
WASM_TIMEOUT_S=60
WASM_MEM_MB=2048
WASM_MAX_PARALLEL=1
WASM_NODE_BIN=node
WASM_RUNTIME_DIR=
# Тул run_python (код в песочнице); без node/Pyodide он скрыт и так
CODEGEN_ENABLED=true
CODEGEN_ATTEMPTS=2
CODEGEN_MAX_ROWS=200000
AGENT_MAX_STEPS=12
# Сколько последних ходов сессии видит планировщик; старшие — через read_history.
CONTEXT_TURNS=5
# Сколько последних включённых воспоминаний сессии идёт в промпты планировщика и инсайта.
CONTEXT_MEMORIES=20
SEMANTIC_TOP_K=5
# Сколько колонок вне топ-K перечислить планировщику по именам (0 — не показывать)
# Если их больше, перечисляются самые близкие к вопросу
SEMANTIC_OTHER_COLUMNS=80

# Коннекторы БД: сколько таблиц схемы максимум подключать как view
DB_MAX_TABLES=50
# Пароль PostgreSQL для переподключения сохранённых источников после рестарта
# (на диске хранится только DSN без пароля). Свой пароль источника —
# POSTGRES_PASSWORD__<datasource_id>, например POSTGRES_PASSWORD__pg_1a2b3c4d5e
POSTGRES_PASSWORD=
# Пароль ClickHouse для того же переподключения; свой пароль источника —
# CLICKHOUSE_PASSWORD__<datasource_id>, например CLICKHOUSE_PASSWORD__ch_1a2b3c4d5e
CLICKHOUSE_PASSWORD=
# Сколько секунд ждать переподключения одного источника (PostgreSQL и ClickHouse) при старте
POSTGRES_RESTORE_TIMEOUT_S=60

# Профилирование: приближённые квартили (approx_quantile) для таблиц от PROFILE_APPROX_MIN_ROWS строк
PROFILE_APPROX_QUANTILE=true
PROFILE_APPROX_MIN_ROWS=100000
# Литералы пропусков в текстовых колонках (JSON-список): профиль помечает их флагом null_tokens
CSV_NULL_TOKENS=["NULL","null","None","NaN","N/A","n/a","#N/A","-"]

# Описание таблицы в паспорт: описание колонки из документа не длиннее порога; колонки уходят
# в LLM пачками; документ-описание длиннее ENRICH_DOCUMENT_MAX_CHARS обрезается
ENRICH_DESCRIPTION_MAX_CHARS=200
ENRICH_BATCH_SIZE=25
ENRICH_DOCUMENT_MAX_CHARS=20000
